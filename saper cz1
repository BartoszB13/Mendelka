<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minesweeper</title>

    <style>
        .tile {
            border: 1px solid;
            width: 25px;
            height: 25px;
            float: left;
            border-collapse: inherit;
            box-sizing: border-box;
            text-align: center;
            line-height: 23px;
            cursor: pointer;
            user-select: none;
        }
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        #formularz {
            width: 220px;
            display: flex;
            flex-direction: column;
            border: 1px solid black;
            padding: 15px;
            margin: 1em;
        }
        #formularz > * {
            margin-bottom: 1em;
        }
    </style>
</head>

<body>


    <script>
        
        let isGameOngoing = true; 
        
        let gameBoard = []; // 
        let minePositions = [];

        let revealedTilesCount = 0;
        let tilesToWin;

        let game_beginign = 0
        let timer_interval = null

        //DO ZROBIENIA:
        // Udoskonalić funkcje wygraj przegraj
        // FUnkcja wygraj nie istnieje i jest zawarta bezposrednio w kodzie
        // Funkjc aygraj nie pokazuje min 
        // Funcja timer Zrobiona

        
        //HTML 
        
        
        // Inicjalizacja Formularza

        function init() {
            const boardContainer = document.createElement("div");
            boardContainer.id = "board";

            const boardSizeInput = document.createElement("input");
            boardSizeInput.type = "number";
            boardSizeInput.min = 4;
            boardSizeInput.value = 10;

            const mineCountInput = document.createElement("input");
            mineCountInput.type = "number";
            mineCountInput.min = 1;
            mineCountInput.value = 10;

            const controlsContainer = document.createElement("div");
            controlsContainer.id = "formularz"

            const boardSizeLabel = document.createTextNode("Rozmiar planszy: ");
            const mineCountLabel = document.createTextNode("Bomby: ");
            const generateButton = document.createElement("button");

            const timer = document.createElement("div")
            timer.id = 'timer'

            generateButton.innerText = "GENERUJ!";

            generateButton.onclick = function () {
                tilesToWin = (Number(boardSizeInput.value) ** 2) - Number(mineCountInput.value);
                revealedTilesCount = 0;
                console.log(tilesToWin);

                update_time(timer)

                const mineCount = Number(mineCountInput.value);
                const boardSize = Number(boardSizeInput.value);

                if (
                    !Number.isInteger(boardSize) ||
                    boardSize < 4 ||
                    boardSize * boardSize <= mineCount
                ) {
                    alert("Wpisz poprawny rozmiar planszy!");
                    return;
                }

                if (
                    !Number.isInteger(mineCount) ||
                    mineCount <= 0
                ) {
                    alert("Wpisz Wiecej niz jedna bombe");
                    return;
                }

                isGameOngoing = true;

                generateGameBoard(boardSize);
                placeMines(mineCount);
                renderBoard();
            };

            controlsContainer.append(
                boardSizeLabel,
                boardSizeInput,
                mineCountLabel,
                mineCountInput,
                generateButton,
                timer
            );
            document.body.append(controlsContainer, boardContainer);
        }

        //Generowanie planszy 2D

        function generateGameBoard(boardSize) {
            gameBoard = [];

            for (let row = 0; row < boardSize; row++) {
                gameBoard[row] = [];

                for (let column = 0; column < boardSize; column++) {
                    gameBoard[row][column] = 0;
                }
            }
        }


        //PLANSZA

        //Rozmieszczenie min

        function placeMines(mineCount) {
            minePositions = []; //RESET POZYCJI MIN

            while (minePositions.length < mineCount) { 
                const column = Math.floor(Math.random() * gameBoard.length);
                const row = Math.floor(Math.random() * gameBoard.length);

                if (gameBoard[row][column] === 0) {
                    gameBoard[row][column] = 1;

                    const minePosition = { column, row };
                    minePositions.push(minePosition);
                }
            }

            console.table(gameBoard);
            console.log(minePositions);
        }

        //Inicjacja planszy

        function renderBoard() {
            const boardContainer = document.getElementById("board");

            

            boardContainer.innerHTML = "";

            boardContainer.style.width = (gameBoard.length * 25) + "px";

            for (let row = 0; row < gameBoard.length; row++) { 
                for (let column = 0; column < gameBoard[row].length; column++) {

                    const tile = document.createElement("div");

                    tile.setAttribute("data-column", column);
                    tile.setAttribute("data-row", row);

                    tile.dataset.revealed = "false";

                    tile.classList.add("tile");

                    tile.addEventListener("click", function () {
                        
                        if (!isGameOngoing) return; //Czy gra się toczy/ NIE zwróć nic

                        if (this.dataset.revealed === "true") return; //Czy pole jest odkryte / TAK zwróć nic

                        if (this.style.backgroundColor === "green") return; // Czy pole jest oflagowane / TAK zwróć nic

                        const tileColumn = Number(this.dataset.column);
                        const tileRow = Number(this.dataset.row);

                        if (gameBoard[tileRow][tileColumn] === 1) {
                            gameLost();
                            return;
                        }

                        revealTile(tileRow, tileColumn); //Odsłonięcie pól wokół zaznczonego pola

                        console.log(revealedTilesCount);

                        if (tilesToWin === revealedTilesCount) { // Primytywna funckja wygranej

                            finishingTime = stop_timer()

                        alert(`Gra WYGRANAA GRATULACJE. Twoj końcowy czas to  ${finishingTime.minutes}:${finishingTime.seconds}`);
                            isGameOngoing = false;
                            return;
                        }
                    });

                    tile.addEventListener("contextmenu", function (event) { //Oflagowanie pola
                        event.preventDefault();

                        if (!isGameOngoing) return;
                        if (this.dataset.revealed === "true") return;

                        const isFlagged = this.style.backgroundColor === "green";

                        if (!isFlagged) {
                            this.style.backgroundColor = "green";
                        } else {
                            this.style.backgroundColor = "";
                        }
                    });

                    boardContainer.append(tile);
                }
            }
        }


        // OBSŁUGA POLA

        //Funkcje pomocnicze

        function isInsideBoard(row, column) {
            return (
                row >= 0 && row < gameBoard.length &&
                column >= 0 && column < gameBoard.length
            );
        }


        function getTileElement(row, column) {
            return document.querySelector(`[data-column="${column}"][data-row="${row}"]`);
        }

        //Odsłoń pola

        function revealTile(row, column) {
            if (!isInsideBoard(row, column)) { return; }

            const tile = getTileElement(row, column);

            if (tile.dataset.revealed === "true") { return; }

            if (tile.style.backgroundColor === "green") { return; }

            tile.dataset.revealed = "true";
            tile.style.backgroundColor = "#ddd";

            revealedTilesCount += 1;

            const minesAround = countMinesAround(column, row);

            if (minesAround > 0) {
                tile.innerText = minesAround;
                return;
            }

            for (let rowOffset = -1; rowOffset <= 1; rowOffset++) {
                for (let columnOffset = -1; columnOffset <= 1; columnOffset++) {
                    revealTile(row + rowOffset, column + columnOffset);
                }
            }
        }

        //Policz miny wokół pola 3x3

        function countMinesAround(column, row) {
            let minesAround = 0;

            for (let rowOffset = -1; rowOffset <= 1; rowOffset++) {
                for (let columnOffset = -1; columnOffset <= 1; columnOffset++) {

                    if (rowOffset === 0 && columnOffset === 0) {
                        continue;
                    }

                    const neighbourColumn = Number(column) + columnOffset;
                    const neighbourRow = Number(row) + rowOffset;

                    if (
                        neighbourColumn >= 0 && neighbourColumn < gameBoard.length &&
                        neighbourRow >= 0 && neighbourRow < gameBoard.length
                    ) {
                        if (gameBoard[neighbourRow][neighbourColumn] === 1) {
                            minesAround++;
                        }
                    }
                }
            }

            return minesAround;
        }

        //STANY GRY

        //Przegrana

        function gameLost() {
            if (!isGameOngoing) return;

            isGameOngoing = false;

            const selector = minePositions
                .map(minePosition => `[data-column="${minePosition.column}"][data-row="${minePosition.row}"]`)
                .join(", ");

            const mineTiles = document.querySelectorAll(selector);

            mineTiles.forEach(mineTile => {
                mineTile.style.backgroundColor = "red";
            });
            finishingTime = stop_timer()

            alert(`Gra przegrana!!!! TWOOOJ KONCOWY CZAS ${finishingTime.minutes}:${finishingTime.seconds}`);
        }

        //Wygrana

        function checkForWin() {

        }

        //CZAS

        function get_time(){
            let overall_sec = Math.floor((Date.now() - game_beginign)/1000);
            let minutes = Math.floor(overall_sec / 60 )
            let seconds = overall_sec % 60

            return {minutes,seconds}
        }

        function update_time(clock){
            clearInterval(timer_interval)
            game_beginign = Date.now()
            
            timer_interval = setInterval(() => {
                time = get_time()
                clock.innerHTML= `${time.minutes} : ${time.seconds}`
                console.log(time)
            }, 250);
        }


        function stop_timer(){
            clearInterval(timer_interval)
            return get_time()
        }


        init();
    </script>
</body>

</html>
